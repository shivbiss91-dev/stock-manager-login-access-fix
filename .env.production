# ==============================================================================
# StockVista Production Environment Configuration
# ==============================================================================

# Server Runtime Mode
NODE_ENV=production

# Server Port and Host Binding
PORT=3001
HOST=0.0.0.0

# Application Public URL (Update with your actual domain or VPS IP)
APP_URL=http://localhost:3001

# SQLite Persistent Data Directory
DATA_DIR=./data

# Security: Disable demo admin login in production
VITE_ENABLE_DEMO_LOGIN=false
